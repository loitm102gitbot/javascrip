@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Bài 1 - PHIẾU THAM GIA CLB TIN HỌC LUBU</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }

        .title {
            text-align: center;
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .highlight {
            color: #00a2e8;
        }

        table {
            border-collapse: collapse;
            width: 700px;
            margin: 0 auto;
            border: 1px solid #888;
        }

        td {
            padding: 8px 12px;
            border-bottom: 1px solid #ddd;
        }

        .error-msg {
            color: red;
            font-style: italic;
        }

        .info-msg {
            color: red;
            font-style: italic;
        }

        .status-msg {
            font-style: italic;
            font-weight: bold;
        }

        select, input[type="text"] {
            width: 200px;
            padding: 4px;
        }
    </style>

    <!-- Nhúng file js đã tạo -->
    <script src="~/script_bai1.js"></script>
</head>
<body>

    <div class="title">PHIẾU THAM GIA CLB TIN HỌC <span class="highlight">LUBU</span></div>

    <form onsubmit="return validateForm();">
        <table>
            <tr>
                <td width="20%">Mã sinh viên :</td>
                <td width="35%">
                    <input type="text" id="masv" placeholder="Nhập Mã SV" />
                </td>
                <td width="45%">
                    <span id="masv_err" class="error-msg"></span>
                </td>
            </tr>
            <tr>
                <td>Họ và tên :</td>
                <td>
                    <input type="text" id="hoten" placeholder="Nhập Họ và tên" />
                </td>
                <td>
                    <span id="hoten_err" class="error-msg"></span>
                </td>
            </tr>
            <tr>
                <td>Tuổi :</td>
                <td>
                    <input type="text" id="tuoi" placeholder="Nhập tuổi > 18" />
                </td>
                <td>
                    <span id="tuoi_err" class="error-msg"></span>
                </td>
            </tr>
            <tr>
                <td>Ngoại ngữ :</td>
                <td>
                    <label><input type="checkbox" id="chkAnh" /> Anh</label>
                    <label><input type="checkbox" id="chkPhap" /> Pháp</label>
                    <label><input type="checkbox" id="chkNhat" /> Nhật</label>
                </td>
                <td>
                    <span id="ngoaingu_info" class="info-msg"></span>
                </td>
            </tr>
            <tr>
                <td>Chuyên ngành :</td>
                <td colspan="2">
                    <select id="chuyennganh" onchange="changeNganh();">
                        <option value="Hệ thống">Hệ thống</option>
                        <option value="Phần mềm">Phần mềm</option>
                        <option value="Mạng máy tính">Mạng máy tính</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td>Sở trường :</td>
                <td colspan="2">
                    <i id="sotruong">Phân tích & Thiết kế</i>
                </td>
            </tr>
            <tr>
                <td></td>
                <td>
                    <input type="submit" value="Đăng ký" />
                </td>
                <td>
                    <span id="status_msg" class="status-msg"></span>
                </td>
            </tr>
        </table>
    </form>

</body>
</html>